local function Toggle(parent, init, cb)
    local on = init
    local track = make("Frame", {
        Size = UDim2.fromOffset(30,15), Position = UDim2.new(1,-33,0.5,-7),
        BackgroundColor3 = on and C.on or C.off, BorderSizePixel = 0, ZIndex = 8, Parent = parent,
    })
    corner(8, track)
    local knob = make("Frame", {
        Size = UDim2.fromOffset(10,10),
        Position = on and UDim2.new(0,16,0.5,-5) or UDim2.new(0,2,0.5,-5),
        BackgroundColor3 = on and C.black or C.muted, BorderSizePixel = 0, ZIndex = 9, Parent = track,
    })
    corner(99, knob)
    local hb = make("TextButton", {
        Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1,
        Text = "", ZIndex = 10, Parent = track,
    })
    local function set(v)
        on = v
        tw(track, { BackgroundColor3 = v and C.on or C.off })
        tw(knob, {
            Position         = v and UDim2.new(0,16,0.5,-5) or UDim2.new(0,2,0.5,-5),
            BackgroundColor3 = v and C.black or C.muted,
        })
        if cb then cb(v) end
    end
    hb.MouseButton1Click:Connect(function() set(not on) end)
    return track, function() return on end, set
end

local function Slider(parent, mn, mx, init, suf, cb)
    suf = suf or ""; local val = init; local W = 78
    local holder = make("Frame", {
        Size = UDim2.fromOffset(W+36,14), Position = UDim2.new(1,-(W+38),0.5,-7),
        BackgroundTransparency = 1, ZIndex = 8, Parent = parent,
    })
    local track = make("Frame", {
        Size = UDim2.fromOffset(W,3), Position = UDim2.new(0,0,0.5,-1),
        BackgroundColor3 = C.off, BorderSizePixel = 0, ZIndex = 8, Parent = holder,
    })
    corner(2, track)
    local fill = make("Frame", {
        Size = UDim2.new((val-mn)/(mx-mn),0,1,0), BackgroundColor3 = C.white,
        BorderSizePixel = 0, ZIndex = 9, Parent = track,
    })
    corner(2, fill)
    local thumb = make("Frame", {
        Size = UDim2.fromOffset(9,9),
        Position = UDim2.new((val-mn)/(mx-mn),-4,0.5,-4),
        BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 10, Parent = track,
    })
    corner(99, thumb)
    local vLbl = make("TextLabel", {
        Size = UDim2.fromOffset(34,14), Position = UDim2.new(0,W+4,0,0),
        BackgroundTransparency = 1, Text = tostring(math.round(val))..suf,
        TextColor3 = C.white, TextSize = 9, Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 8, Parent = holder,
    })
    local sliding = false
    local hb = make("TextButton", {
        Size = UDim2.fromOffset(W,14), BackgroundTransparency = 1,
        Text = "", ZIndex = 11, Parent = holder,
    })
    local function upd(ix)
        local rel = math.clamp((ix - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        val = math.round(mn + rel*(mx-mn))
        fill.Size = UDim2.new(rel,0,1,0)
        thumb.Position = UDim2.new(rel,-4,0.5,-4)
        vLbl.Text = tostring(val)..suf
        if cb then cb(val) end
    end
    hb.MouseButton1Down:Connect(function() sliding = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then upd(i.Position.X) end
    end)
    hb.MouseButton1Click:Connect(function() upd(UserInputService:GetMouseLocation().X) end)
end

local function Dropdown(parent, opts, init, cb)
    local cur = init or opts[1]; local open = false
    local btn = make("TextButton", {
        Size = UDim2.fromOffset(80,17), Position = UDim2.new(1,-83,0.5,-8),
        BackgroundColor3 = C.panel, Text = cur, TextColor3 = C.label,
        TextSize = 9, Font = Enum.Font.Code, BorderSizePixel = 0, ZIndex = 12, Parent = parent,
    })
    corner(3, btn); stroke(C.border, 1, btn)
    local dd = make("Frame", {
        Size = UDim2.fromOffset(80, #opts*19+4), Position = UDim2.new(1,-83,1,2),
        BackgroundColor3 = C.panel, BorderSizePixel = 0, ZIndex = 30, Visible = false, Parent = parent,
    })
    corner(3, dd); stroke(C.border, 1, dd)
    make("UIPadding",    { PaddingTop = UDim.new(0,2), PaddingBottom = UDim.new(0,2), Parent = dd })
    make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = dd })
    for i, opt in ipairs(opts) do
        local item = make("TextButton", {
            Size = UDim2.new(1,0,0,19), BackgroundTransparency = 1, Text = opt,
            TextColor3 = opt==cur and C.white or C.muted, TextSize = 9,
            Font = Enum.Font.Code, LayoutOrder = i, ZIndex = 31, Parent = dd,
        })
        item.MouseButton1Click:Connect(function()
            cur = opt; btn.Text = opt; dd.Visible = false; open = false
            for _, c in ipairs(dd:GetChildren()) do
                if c:IsA("TextButton") then c.TextColor3 = c.Text==cur and C.white or C.muted end
            end
            if cb then cb(opt) end
        end)
    end
    btn.MouseButton1Click:Connect(function() open = not open; dd.Visible = open end)
end

local function clearScroll()
    for _, c in ipairs(Scroll:GetChildren()) do
        if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
    end
end

