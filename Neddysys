-- ================================================
-- AIMBOT — target finder  (FIXED hit part lookup)
-- ================================================

local HIT_PARTS = {
    Head = {"Head"},
    Neck = {"UpperTorso", "Torso"},
    Body = {"HumanoidRootPart", "UpperTorso", "Torso"},
}

local function getBestTarget()
    local cam    = workspace.CurrentCamera
    local best   = Cfg.FOVRadius
    local found  = nil
    local vp     = cam.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if Cfg.TeamCheck and plr.Team == LocalPlayer.Team then continue end

        local char = plr.Character; if not char then continue end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        -- resolve hit part with fallback chain
        local part
        for _, name in ipairs(HIT_PARTS[Cfg.HitPart] or HIT_PARTS.Head) do
            part = char:FindFirstChild(name)
            if part then break end
        end
        if not part then part = char:FindFirstChild("HumanoidRootPart") end
        if not part then continue end

        -- wall check — exclude entire local character from ray
        if Cfg.WallCheck then
            local rp = RaycastParams.new()
            rp.FilterDescendantsInstances = {LocalPlayer.Character or game.Workspace}
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local origin = cam.CFrame.Position
            local dir    = part.Position - origin
            local res    = workspace:Raycast(origin, dir, rp)
            if res and not res.Instance:IsDescendantOf(char) then continue end
        end

        local sp, vis = cam:WorldToViewportPoint(part.Position)
        if not vis then continue end

        local dist = math.sqrt((sp.X - cx)^2 + (sp.Y - cy)^2)
        if dist < best then best = dist; found = part end
    end
    return found
end

-- ================================================
-- SILENT AIM — hook workspace.Raycast safely
-- ================================================

local silentPart = nil

-- Only hook if the executor exposes the raw method; skip if already hooked
if not workspace._HXN_hooked then
    workspace._HXN_hooked = true
    local _orig = workspace.Raycast
    workspace.Raycast = function(ws, origin, direction, params, ...)
        if Cfg.SilentAim and silentPart and silentPart.Parent then
            direction = (silentPart.Position - origin).Unit * direction.Magnitude
        end
        return _orig(ws, origin, direction, params, ...)
    end
end

