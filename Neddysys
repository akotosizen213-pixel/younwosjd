-- ================================================
-- AIMBOT RENDER LOOP  (FIXED: camera CFrame write)
-- ================================================

RunService.RenderStepped:Connect(function(dt)
    local cam = workspace.CurrentCamera

    -- update silent aim target every frame
    silentPart = (Cfg.SilentAim or Cfg.AimEnabled) and getBestTarget() or nil

    -- FOV circle
    if fovDraw then
        fovDraw.Visible  = Cfg.AimEnabled and Cfg.FOVEnabled
        fovDraw.Radius   = Cfg.FOVRadius
        fovDraw.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    end

    if not Cfg.AimEnabled then return end
    if not UserInputService:IsMouseButtonPressed(Cfg.MouseBind) then return end

    local part = getBestTarget()   -- fresh call for aimbot (not shared with silent)
    if not part or not part.Parent then return end

    local targetPos = part.Position

    -- velocity prediction
    if Cfg.Prediction then
        local vel = part.AssemblyLinearVelocity
        if vel then
            targetPos = targetPos + vel * (Cfg.PredAmt * dt * 60)
        end
    end

    local _, vis = cam:WorldToViewportPoint(targetPos)
    if not vis then return end

    -- smooth lerp toward target — clamp smoothing so 1 = instant
    local alpha  = math.clamp(1 / math.max(1, Cfg.Smoothing), 0.01, 1)
    local lookAt = CFrame.lookAt(cam.CFrame.Position, targetPos)
    cam.CFrame   = cam.CFrame:Lerp(lookAt, alpha)
end)

-- ================================================
-- ESP RENDER LOOP  (FIXED: team check nil guard)
-- ================================================

local hlCache = {}

local function removeHL(plr)
    if hlCache[plr] then
        pcall(function() hlCache[plr]:Destroy() end)
        hlCache[plr] = nil
    end
end

RunService.RenderStepped:Connect(function()
    local cam   = workspace.CurrentCamera
    local myTeam = LocalPlayer.Team  -- can be nil in teamless games

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end

        if not Cfg.ESPEnabled then removeHL(plr); continue end

        -- team check: only skip teammates when ShowTeam is off AND teams exist
        if not Cfg.ShowTeam and myTeam and plr.Team == myTeam then
            removeHL(plr); continue
        end

        local char = plr.Character
        if not char then removeHL(plr); continue end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then removeHL(plr); continue end

        if (cam.CFrame.Position - root.Position).Magnitude > Cfg.MaxDist then
            removeHL(plr); continue
        end

        if Cfg.BodyHL then
            local hl = hlCache[plr]
            if not hl or not hl.Parent then
                hl = Instance.new("Highlight")
                hl.Parent    = char
                hlCache[plr] = hl
            end
            hl.Adornee             = char
            hl.FillColor           = Cfg.HLColor
            hl.FillTransparency    = 1 - Cfg.HLOpacity
            hl.OutlineColor        = Cfg.HLColor
            hl.OutlineTransparency = 0
        else
            removeHL(plr)
        end
    end
end)

Players.PlayerRemoving:Connect(removeHL)

